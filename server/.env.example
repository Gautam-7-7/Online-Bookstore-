MONGODB_URI=mongodb://127.0.0.1:27017/online_bookstore
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Razorpay test credentials; never use production secrets in a local .env file.
RAZORPAY_KEY_ID=rzp_test_TvO9iHLXFMDkYt
RAZORPAY_KEY_SECRET=EUbuI5oxk7AxwEh3j9UD8Yg8
RAZORPAY_CURRENCY=INR
RAZORPAY_WEBHOOK_SECRET=CXDxnVH6qjTnfg@

# Choose "smtp" (default) or "brevo" (HTTPS API, works on networks blocking SMTP).
EMAIL_PROVIDER=smtp
# Brevo: create an API key and verify the sender address in your Brevo account.
# BREVO_API_KEY=replace-with-brevo-api-key
# EMAIL_FROM="Online Bookstore <verified-sender@example.com>"

# SMTP settings (used when EMAIL_PROVIDER=smtp).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Online Bookstore <no-reply@example.com>"
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Optional operational settings.
ORDER_RETURN_WINDOW_DAYS=7
SHIPPING_WEBHOOK_SECRET=replace-with-a-long-random-secret
