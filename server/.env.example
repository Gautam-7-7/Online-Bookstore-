MONGODB_URI=mongodb://127.0.0.1:27017/online_bookstore
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Razorpay test credentials; never use production secrets in a local .env file.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-secret
RAZORPAY_CURRENCY=INR
RAZORPAY_WEBHOOK_SECRET=replace-with-the-configured-webhook-secret
# For local UI demos without Razorpay credentials only:
# PAYMENT_GATEWAY_MODE=mock
# MOCK_PAYMENT_SECRET=local-only-secret

# Set these to enable password reset email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Online Bookstore <no-reply@example.com>"
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Optional operational settings.
ORDER_RETURN_WINDOW_DAYS=7
SHIPPING_WEBHOOK_SECRET=replace-with-a-long-random-secret
